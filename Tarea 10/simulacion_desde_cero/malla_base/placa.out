 RELEASE= 2026 R1              BUILD= 26.1      UP20260202   VERSION=WINDOWS x64 
 CURRENT JOBNAME=placa  20:48:45  NOV 10, 2026  Elapsed Time=       0.078

     1  ! ================================================================  
     2  !  Analisis modal libre-libre de la placa PLA-001 (desde cero)  
     3  !  Unidades SI: m, kg, s, Pa
     4  !  Geometria segun plano PLA-001 (cotas en mm convertidas a m)  
     5  ! ================================================================  
     6  /BATCH  
     7  /TITLE,Placa PLA-001 - Analisis modal libre (Al 2024-T3)
     8  /PREP7  
     9  mm = 1e-3   
    10      
    11  ! ---------- Dimensiones del plano ----------   
    12  L   = 202*mm        ! largo (X) 
    13  W   = 188*mm        ! ancho (Y) 
    14  T   = 12.7*mm       ! espesor (Z)   
    15  r1  = 4.00*mm/2     ! barrenos chicos Ø4.00 (x63)  
    16  r2  = 9.53*mm/2     ! barrenos grandes Ø9.53 = 3/8 in (x2) 
    17  x0  = 27*mm         ! primera columna desde el borde izquierdo  
    18  dx  = 25*mm         ! 25 x 6
    19  y0  = 18*mm         ! primera fila desde el borde inferior  
    20  dy  = 18.5*mm       ! 18.5 x 8  
    21  ! barrenos grandes: el inferior a 62 del borde derecho y 33 del inferior,   
    22  ! el superior 101.60 a la izquierda y 101.60 arriba del inferior
    23  xb2 = L-62*mm   
    24  yb2 = 33*mm 
    25  xb1 = xb2-101.6*mm  
    26  yb1 = yb2+101.6*mm  
    27      
    28  ! ---------- Material: Aluminio 2024-T3 ----------  
    29  MP,EX,1,73.1e9  
    30  MP,PRXY,1,0.33  
    31  MP,DENS,1,2780  
    32      
    33  ! ---------- Elementos ----------   
    34  ET,1,MESH200,6       ! cuadrilatero de 8 nodos solo para mallar la cara 
    35  ET,2,SOLID186        ! hexaedro cuadratico de 20 nodos  
    36      
    37  ! ---------- Geometria 2D (cara) ---------- 
    38  RECTNG,0,L,0,W  
    39  *DO,i,1,7   
    40    *DO,j,1,9 
    41      CYL4,x0+(i-1)*dx,y0+(j-1)*dy,r1 
    42    *ENDDO
    43  *ENDDO  
    44  CYL4,xb1,yb1,r2 
    45  CYL4,xb2,yb2,r2 
    46  ASEL,S,AREA,,2,66   
    47  CM,AGUJ,AREA
    48  ALLSEL  
    49  ASBA,1,AGUJ 
    50  ALLSEL  
    51      
    52  ! ---------- Malla ----------   
    53  ! (la version Student limita el modelo a 128 000 nodos) 
    54  ! Parametros de malla; se pueden cambiar desde la linea de comandos 
    55  ! (p. ej. MAPDL -b -i placa_modal.inp -hs 3 -nd 3 -nl 3)
    56  *GET,_t,PARM,hs,TYPE
    57  *IF,_t,EQ,-1,THEN   
    58    hs = 4             ! tamano de elemento en la cara (mm)   
    59  *ENDIF  
    60  *GET,_t,PARM,nd,TYPE
    61  *IF,_t,EQ,-1,THEN   
    62    nd = 2             ! divisiones por cuarto de barreno chico   
    63  *ENDIF  
    64  *GET,_t,PARM,nl,TYPE
    65  *IF,_t,EQ,-1,THEN   
    66    nl = 3             ! capas de elementos en el espesor 
    67  *ENDIF  
    68  ESIZE,hs*mm 
    69  LSEL,S,RADIUS,,r1   
    70  LESIZE,ALL,,,nd      ! 4*nd divisiones por barreno chico
    71  LSEL,S,RADIUS,,r2   
    72  LESIZE,ALL,,,2*nd    ! 8*nd divisiones por barreno grande   
    73  ALLSEL  
    74  TYPE,1  
    75  MSHAPE,0,2D 
    76  MSHKEY,0
    77  AMESH,ALL   
    78  ! extrusion a traves del espesor: nl capas de hexaedros cuadraticos 
    79  TYPE,2  
    80  MAT,1   
    81  EXTOPT,ESIZE,nl,0   
    82  EXTOPT,ACLEAR,1 
    83  VEXT,ALL,,,0,0,T
    84  ACLEAR,ALL  
    85  ETDELE,1
    86  ALLSEL  
    87      
    88  *GET,nn,NODE,0,COUNT
    89  *GET,ne,ELEM,0,COUNT
    90  VSUM
    91  *GET,vtot,VOLU,0,VOLU   
    92  FINISH  
    93      
    94  ! ---------- Solucion modal libre (sin restricciones) ----------
    95  /SOLU   
    96  ANTYPE,MODAL
    97  MODOPT,LANB,16,0,,,OFF   ! 16 modos desde 0 Hz: 6 de cuerpo rigido + 10 elasticos   
    98  MXPAND,16,,,YES 
    99  SOLVE   
   100  *DIM,frq,ARRAY,16   
   101  *DO,k,1,16  
   102    *GET,frq(k),MODE,k,FREQ   
   103  *ENDDO  
   104  FINISH  
   105      
   106  ! ---------- Reporte en texto ----------
   107  *CFOPEN,resultados,txt  
   108  *VWRITE,nn,ne   
   109  ('Nodos: ',F10.0,'   Elementos: ',F10.0)
   110  *VWRITE,vtot*1e9,vtot*2780  
   111  ('Volumen (mm3): ',F12.1,'   Masa (kg): ',F10.5)
   112  *VWRITE 
   113  ('Modo   Frecuencia (Hz)')  
   114  *VWRITE,hs,nd*4,nl  
   115  ('Malla: ESIZE (mm)=',F5.2,'  div. barreno chico=',F4.0,'  capas=',F3.0)
   116  *DO,k,1,16  
   117    fk = frq(k)   
   118  *VWRITE,k,fk
   119  (F4.0,F20.4)
   120  *ENDDO  
   121  *CFCLOS 
   122      
   123  ! ---------- Imagenes: malla y formas modales ----------
   124  /POST1  
   125  /SHOW,PNG   
   126  /GFILE,1200 
   127  /RGB,INDEX,100,100,100,0
   128  /RGB,INDEX,0,0,0,15 
   129  /VIEW,1,1,-1.2,1.4  
   130  /ANG,1  
   131  /PLOPTS,DATE,0  
   132  /TRIAD,LBOT 
   133  /TITLE,Malla: SOLID186 - %nn% nodos, %ne% elementos 
   134  EPLOT   
   135  /GLINE,1,-1            ! sin lineas de elementos en los contornos   
   136  /EDGE,1,1   
   137  /DSCALE,1,0.008        ! escala de deformacion (modos normalizados a masa)  
   138  *DO,k,1,16  
   139    SET,1,k   
   140    fk = frq(k)   
   141    *IF,k,LE,6,THEN   
   142      /TITLE,Modo %k% (cuerpo rigido) - f = %fk% Hz   
   143    *ELSE 
   144      /TITLE,Modo elastico %k-6% - f = %fk% Hz
   145    *ENDIF
   146    PLNSOL,U,SUM,1
   147  *ENDDO  
   148  /SHOW,CLOSE 
   149  FINISH  

