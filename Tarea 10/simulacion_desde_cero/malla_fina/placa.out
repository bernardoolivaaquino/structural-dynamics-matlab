 RELEASE= 2026 R1              BUILD= 26.1      UP20260202   VERSION=WINDOWS x64 
 CURRENT JOBNAME=placa  20:50:08  NOV 10, 2026  Elapsed Time=       0.094

     1  hs = 3  
     2  nd = 3  
     3  nl = 3  
     4  ! ================================================================  
     5  !  Analisis modal libre-libre de la placa PLA-001 (desde cero)  
     6  !  Unidades SI: m, kg, s, Pa
     7  !  Geometria segun plano PLA-001 (cotas en mm convertidas a m)  
     8  ! ================================================================  
     9  /BATCH  
    10  /TITLE,Placa PLA-001 - Analisis modal libre (Al 2024-T3)
    11  /PREP7  
    12  mm = 1e-3   
    13      
    14  ! ---------- Dimensiones del plano ----------   
    15  L   = 202*mm        ! largo (X) 
    16  W   = 188*mm        ! ancho (Y) 
    17  T   = 12.7*mm       ! espesor (Z)   
    18  r1  = 4.00*mm/2     ! barrenos chicos ??4.00 (x63)  
    19  r2  = 9.53*mm/2     ! barrenos grandes ??9.53 = 3/8 in (x2) 
    20  x0  = 27*mm         ! primera columna desde el borde izquierdo  
    21  dx  = 25*mm         ! 25 x 6
    22  y0  = 18*mm         ! primera fila desde el borde inferior  
    23  dy  = 18.5*mm       ! 18.5 x 8  
    24  ! barrenos grandes: el inferior a 62 del borde derecho y 33 del inferior,   
    25  ! el superior 101.60 a la izquierda y 101.60 arriba del inferior
    26  xb2 = L-62*mm   
    27  yb2 = 33*mm 
    28  xb1 = xb2-101.6*mm  
    29  yb1 = yb2+101.6*mm  
    30      
    31  ! ---------- Material: Aluminio 2024-T3 ----------  
    32  MP,EX,1,73.1e9  
    33  MP,PRXY,1,0.33  
    34  MP,DENS,1,2780  
    35      
    36  ! ---------- Elementos ----------   
    37  ET,1,MESH200,6       ! cuadrilatero de 8 nodos solo para mallar la cara 
    38  ET,2,SOLID186        ! hexaedro cuadratico de 20 nodos  
    39      
    40  ! ---------- Geometria 2D (cara) ---------- 
    41  RECTNG,0,L,0,W  
    42  *DO,i,1,7   
    43    *DO,j,1,9 
    44      CYL4,x0+(i-1)*dx,y0+(j-1)*dy,r1 
    45    *ENDDO
    46  *ENDDO  
    47  CYL4,xb1,yb1,r2 
    48  CYL4,xb2,yb2,r2 
    49  ASEL,S,AREA,,2,66   
    50  CM,AGUJ,AREA
    51  ALLSEL  
    52  ASBA,1,AGUJ 
    53  ALLSEL  
    54      
    55  ! ---------- Malla ----------   
    56  ! (la version Student limita el modelo a 128 000 nodos) 
    57  ! Parametros de malla; se pueden cambiar desde la linea de comandos 
    58  ! (p. ej. MAPDL -b -i placa_modal.inp -hs 3 -nd 3 -nl 3)
    59  *GET,_t,PARM,hs,TYPE
    60  *IF,_t,EQ,-1,THEN   
    61    hs = 4             ! tamano de elemento en la cara (mm)   
    62  *ENDIF  
    63  *GET,_t,PARM,nd,TYPE
    64  *IF,_t,EQ,-1,THEN   
    65    nd = 2             ! divisiones por cuarto de barreno chico   
    66  *ENDIF  
    67  *GET,_t,PARM,nl,TYPE
    68  *IF,_t,EQ,-1,THEN   
    69    nl = 3             ! capas de elementos en el espesor 
    70  *ENDIF  
    71  ESIZE,hs*mm 
    72  LSEL,S,RADIUS,,r1   
    73  LESIZE,ALL,,,nd      ! 4*nd divisiones por barreno chico
    74  LSEL,S,RADIUS,,r2   
    75  LESIZE,ALL,,,2*nd    ! 8*nd divisiones por barreno grande   
    76  ALLSEL  
    77  TYPE,1  
    78  MSHAPE,0,2D 
    79  MSHKEY,0
    80  AMESH,ALL   
    81  ! extrusion a traves del espesor: nl capas de hexaedros cuadraticos 
    82  TYPE,2  
    83  MAT,1   
    84  EXTOPT,ESIZE,nl,0   
    85  EXTOPT,ACLEAR,1 
    86  VEXT,ALL,,,0,0,T
    87  ACLEAR,ALL  
    88  ETDELE,1
    89  ALLSEL  
    90      
    91  *GET,nn,NODE,0,COUNT
    92  *GET,ne,ELEM,0,COUNT
    93  VSUM
    94  *GET,vtot,VOLU,0,VOLU   
    95  FINISH  
    96      
    97  ! ---------- Solucion modal libre (sin restricciones) ----------
    98  /SOLU   
    99  ANTYPE,MODAL
   100  MODOPT,LANB,16,0,,,OFF   ! 16 modos desde 0 Hz: 6 de cuerpo rigido + 10 elasticos   
   101  MXPAND,16,,,YES 
   102  SOLVE   
   103  *DIM,frq,ARRAY,16   
   104  *DO,k,1,16  
   105    *GET,frq(k),MODE,k,FREQ   
   106  *ENDDO  
   107  FINISH  
   108      
   109  ! ---------- Reporte en texto ----------
   110  *CFOPEN,resultados,txt  
   111  *VWRITE,nn,ne   
   112  ('Nodos: ',F10.0,'   Elementos: ',F10.0)
   113  *VWRITE,vtot*1e9,vtot*2780  
   114  ('Volumen (mm3): ',F12.1,'   Masa (kg): ',F10.5)
   115  *VWRITE 
   116  ('Modo   Frecuencia (Hz)')  
   117  *VWRITE,hs,nd*4,nl  
   118  ('Malla: ESIZE (mm)=',F5.2,'  div. barreno chico=',F4.0,'  capas=',F3.0)
   119  *DO,k,1,16  
   120    fk = frq(k)   
   121  *VWRITE,k,fk
   122  (F4.0,F20.4)
   123  *ENDDO  
   124  *CFCLOS 
   125      
   126  ! ---------- Imagenes: malla y formas modales ----------
   127  /POST1  
   128  /SHOW,PNG   
   129  /GFILE,1200 
   130  /RGB,INDEX,100,100,100,0
   131  /RGB,INDEX,0,0,0,15 
   132  /VIEW,1,1,-1.2,1.4  
   133  /ANG,1  
   134  /PLOPTS,DATE,0  
   135  /TRIAD,LBOT 
   136  /TITLE,Malla: SOLID186 - %nn% nodos, %ne% elementos 
   137  EPLOT   
   138  /GLINE,1,-1            ! sin lineas de elementos en los contornos   
   139  /EDGE,1,1   
   140  /DSCALE,1,0.008        ! escala de deformacion (modos normalizados a masa)  
   141  *DO,k,1,16  
   142    SET,1,k   
   143    fk = frq(k)   
   144    *IF,k,LE,6,THEN   
   145      /TITLE,Modo %k% (cuerpo rigido) - f = %fk% Hz   
   146    *ELSE 
   147      /TITLE,Modo elastico %k-6% - f = %fk% Hz
   148    *ENDIF
   149    PLNSOL,U,SUM,1
   150  *ENDDO  
   151  /SHOW,CLOSE 
   152  FINISH  

